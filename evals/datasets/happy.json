  "cases": [
    {
      "id": "hk-close",
      "title": "What time do you close?",
      "input": {
        "prompt": "What time do you close?",
        "school": "harbor-kids"
      },
      "expect": {
        "outcome": "served",
        "assertions": [
          {
            "type": "regexPresent",
            "pattern": "5:30",
            "path": "$.output.text",
            "when": [
              "served"
            ]
          }
        ]
      },
      "smoke": true
    },
    {
      "id": "hk-fever",
      "title": "My son had a fever of 100.6 last night. Can he come in today?",
      "input": {
        "prompt": "My son had a fever of 100.6 last night. Can he come in today?",
        "school": "harbor-kids"
      },
      "expect": {
        "outcome": "served",
        "assertions": [
          {
            "type": "regexPresent",
            "pattern": "24 hours|100\\.4",
            "path": "$.output.text",
            "when": [
              "served"
            ]
          }
        ]
      },
      "smoke": true
    },
